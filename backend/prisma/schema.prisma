generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model SiteContent {
  id        String   @id @default(uuid())
  section   String // hero, about, projects, contact, footer
  key       String // title, subtitle, body, image_url, cta_text, cta_url
  value     String   @db.Text
  updatedAt DateTime @updatedAt

  @@unique([section, key])
}

model ContactSubmission {
  id           String   @id @default(uuid())
  name         String
  email        String
  phone        String?
  message      String   @db.Text
  source       String? // landing, tienda, referencia
  referralCode String? // 3IP-XXXXXX capturado del query param ?ref=
  createdAt    DateTime @default(now())
}

model Project {
  id          String    @id @default(uuid())
  slug        String    @unique
  name        String
  subtitle    String?
  description String    @db.Text
  location    String?
  coverImage  String? // Cloudinary URL
  images      String[] // Cloudinary URLs
  features    Json? // { bedrooms, bathrooms, m2, amenities... }
  priceFrom   Float?
  priceLabel  String? // "Desde $12,000", "Fracciones desde $5,000"
  active      Boolean   @default(true)
  featured    Boolean   @default(false)
  products    Product[]
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
}

enum ProductType {
  TRAVEL_MEMBERSHIP
  FRACTIONAL_PROPERTY
  TRADITIONAL_PROPERTY
  LAND
}

model Product {
  id          String           @id @default(uuid())
  slug        String           @unique
  name        String
  type        ProductType
  price       Float
  promoPrice  Float?
  description String           @db.Text
  features    Json? // ["Beneficio 1", "Beneficio 2", ...]
  images      String[] // Cloudinary URLs
  projectId   String?
  project     Project?         @relation(fields: [projectId], references: [id])
  active      Boolean          @default(true)
  featured    Boolean          @default(false)
  inquiries   ProductInquiry[]
  commissions Commission[]
  purchases   Purchase[]
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt
}

model ProductInquiry {
  id           String   @id @default(uuid())
  productId    String
  product      Product  @relation(fields: [productId], references: [id])
  name         String
  email        String
  phone        String?
  message      String?  @db.Text
  referralCode String? // 3IP-XXXXXX capturado del query param ?ref=
  status       String   @default("pending") // pending, contacted, closed
  createdAt    DateTime @default(now())
}

// ============================================================
// FASE 2 — PROGRAMA DE REFERIDOS (OFICINA VIRTUAL)
// ============================================================

enum MemberStatus {
  PREMIERE
  ELITE
  SUSPENDED
}

enum EliteBy {
  PURCHASE
  REFERRALS
}

enum CommissionStatus {
  PENDING
  CONFIRMED
  LIQUIDATED
  PAID
  REVERSED
}

model ReferralMember {
  id                    String           @id @default(uuid())
  userId                String?          @unique // FK auth.users (Supabase) — nullable hasta Fase 3
  passwordHash          String // bcrypt — auth JWT simple en Fase 2
  fullName              String
  email                 String           @unique
  phone                 String?
  docId                 String           @unique
  docType               String           @default("cedula")
  status                MemberStatus     @default(PREMIERE)
  referralCode          String           @unique
  referrerId            String?
  referrer              ReferralMember?  @relation("ReferralChain", fields: [referrerId], references: [id])
  referrals             ReferralMember[] @relation("ReferralChain")
  walletBalance         Float            @default(0)
  totalEarned           Float            @default(0)
  totalReferrals        Int              @default(0)
  lastReferralAt        DateTime?
  inactiveSince         DateTime?
  eliteSince            DateTime?
  eliteBy               EliteBy?
  referralsCountToElite Int              @default(0)
  membershipAwarded     Boolean          @default(false)
  bankInfo              Json?
  payoutMethod          String?
  payoutEmail           String?
  kycVerified           Boolean          @default(false)
  kycVerifiedAt         DateTime?
  // Perfil social (Fase 4)
  bio                   String?
  avatarUrl             String?
  location              String?
  interests             String[]
  createdAt             DateTime         @default(now())
  updatedAt             DateTime         @updatedAt

  sentReferrals     Referral[]     @relation("Referrer")
  receivedReferrals Referral[]     @relation("Referred")
  commissions       Commission[]
  payouts           Payout[]
  links             ReferralLink[]
  notifications     Notification[]
  purchases         Purchase[]     @relation("Purchases")
}

model Referral {
  id                String         @id @default(uuid())
  referrerId        String
  referrer          ReferralMember @relation("Referrer", fields: [referrerId], references: [id])
  referredId        String
  referred          ReferralMember @relation("Referred", fields: [referredId], references: [id])
  level             Int // 1 o 2
  attributionMethod String         @default("link") // link, code, qr, manual
  cookieId          String?
  status            String         @default("pending") // pending, active, inactive
  registeredAt      DateTime       @default(now())
  firstPurchaseAt   DateTime?
  commissions       Commission[]
}

model ReferralLink {
  id          String         @id @default(uuid())
  memberId    String
  member      ReferralMember @relation(fields: [memberId], references: [id])
  code        String         @unique
  fullUrl     String
  shortUrl    String?
  qrCodeUrl   String?
  clicks      Int            @default(0)
  conversions Int            @default(0)
  status      String         @default("active")
  createdAt   DateTime       @default(now())
}

model Commission {
  id            String           @id @default(uuid())
  memberId      String
  member        ReferralMember   @relation(fields: [memberId], references: [id])
  // referralId es opcional: las comisiones por compra de un cliente (checkout)
  // se vinculan a Purchase, no a un Referral miembro-a-miembro.
  referralId    String?
  referral      Referral?        @relation(fields: [referralId], references: [id])
  purchaseId    String?
  purchase      Purchase?        @relation(fields: [purchaseId], references: [id])
  productId     String?
  product       Product?         @relation(fields: [productId], references: [id])
  transactionId String?
  level         Int              @default(1) // 1 o 2
  amount        Float
  rate          Float
  type          String           @default("percentage") // percentage, fixed
  status        CommissionStatus @default(PENDING)
  holdUntil     DateTime?
  paidAt        DateTime?
  createdAt     DateTime         @default(now())
}

model Payout {
  id        String         @id @default(uuid())
  memberId  String
  member    ReferralMember @relation(fields: [memberId], references: [id])
  amount    Float
  method    String
  reference String?
  status    String         @default("pending") // pending, processing, paid, failed
  paidAt    DateTime?
  createdAt DateTime       @default(now())
}

model Notification {
  id        String         @id @default(uuid())
  memberId  String
  member    ReferralMember @relation(fields: [memberId], references: [id])
  type      String // new_referral, first_purchase, commission_confirmed, payout_processed, elite_ascension, inactivity_warning
  title     String
  body      String         @db.Text
  read      Boolean        @default(false)
  createdAt DateTime       @default(now())
}

// ============================================================
// FASE 3 — ADMIN PANEL + CHECKOUT
// ============================================================

model StaffUser {
  id        String     @id @default(uuid())
  username  String     @unique
  password  String // bcrypt hash
  role      String     @default("admin") // superadmin, admin, content
  active    Boolean    @default(true)
  auditLogs AuditLog[]
  createdAt DateTime   @default(now())
}

model Purchase {
  id            String          @id @default(uuid())
  productId     String
  product       Product         @relation(fields: [productId], references: [id])
  customerName  String
  customerEmail String
  customerPhone String?
  amount        Float
  status        String          @default("pending") // pending, confirmed, completed, cancelled
  referralCode  String? // código de referido usado
  referrerId    String? // FK ReferralMember — quién gana la comisión
  referrer      ReferralMember? @relation("Purchases", fields: [referrerId], references: [id])
  commissions   Commission[]
  notes         String?         @db.Text
  confirmedAt   DateTime?
  createdAt     DateTime        @default(now())
  updatedAt     DateTime        @updatedAt
}

model AuditLog {
  id        String     @id @default(uuid())
  staffId   String?
  staff     StaffUser? @relation(fields: [staffId], references: [id])
  action    String // create, update, delete, confirm, reject, login
  entity    String // product, project, member, commission, purchase
  entityId  String?
  details   Json?
  createdAt DateTime   @default(now())
}

// ============================================================
// FASE 4 — RED SOCIAL DE LA COMUNIDAD
// userId es el id de ReferralMember (sin FK Prisma: se resuelve manualmente).
// ============================================================

model SocialPost {
  id          String           @id @default(uuid())
  userId      String
  content     String           @db.Text
  images      String[]
  linkUrl     String?
  linkPreview Json?
  groupId     String?
  group       SocialGroup?     @relation(fields: [groupId], references: [id])
  pinned      Boolean          @default(false)
  comments    SocialComment[]
  reactions   SocialReaction[]
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt

  @@index([groupId])
  @@index([userId])
  @@index([createdAt])
}

model SocialComment {
  id        String          @id @default(uuid())
  postId    String
  post      SocialPost      @relation(fields: [postId], references: [id], onDelete: Cascade)
  userId    String
  content   String          @db.Text
  parentId  String?
  parent    SocialComment?  @relation("CommentReplies", fields: [parentId], references: [id])
  replies   SocialComment[] @relation("CommentReplies")
  createdAt DateTime        @default(now())

  @@index([postId])
}

model SocialReaction {
  id        String     @id @default(uuid())
  postId    String
  post      SocialPost @relation(fields: [postId], references: [id], onDelete: Cascade)
  userId    String
  type      String // like, love, useful, interesting, celebrate
  createdAt DateTime   @default(now())

  @@unique([postId, userId])
}

model SocialGroup {
  id          String              @id @default(uuid())
  name        String
  slug        String              @unique
  description String?
  coverImage  String?
  privacy     String              @default("public") // public, private
  createdBy   String
  members     SocialGroupMember[]
  posts       SocialPost[]
  events      SocialEvent[]
  createdAt   DateTime            @default(now())
  updatedAt   DateTime            @updatedAt
}

model SocialGroupMember {
  id       String      @id @default(uuid())
  groupId  String
  group    SocialGroup @relation(fields: [groupId], references: [id], onDelete: Cascade)
  userId   String
  role     String      @default("member") // admin, moderator, member
  joinedAt DateTime    @default(now())

  @@unique([groupId, userId])
}

model SocialEvent {
  id          String                @id @default(uuid())
  groupId     String
  group       SocialGroup           @relation(fields: [groupId], references: [id], onDelete: Cascade)
  title       String
  description String                @db.Text
  location    String?
  startDate   DateTime
  endDate     DateTime?
  coverImage  String?
  createdBy   String
  attendees   SocialEventAttendee[]
  createdAt   DateTime              @default(now())
}

model SocialEventAttendee {
  id        String      @id @default(uuid())
  eventId   String
  event     SocialEvent @relation(fields: [eventId], references: [id], onDelete: Cascade)
  userId    String
  status    String      @default("going") // going, maybe, not_going
  createdAt DateTime    @default(now())

  @@unique([eventId, userId])
}

model DirectMessage {
  id         String   @id @default(uuid())
  senderId   String
  receiverId String
  content    String   @db.Text
  read       Boolean  @default(false)
  createdAt  DateTime @default(now())

  @@index([senderId, receiverId])
  @@index([receiverId, senderId])
}
