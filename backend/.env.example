# Base de datos PostgreSQL de Railway
DATABASE_URL="postgresql://user:password@host:port/dbname"

# Cloudinary (mismo account que OmniDrive/Imeldi)
CLOUDINARY_URL="cloudinary://api_key:api_secret@cloud_name"

# JWT para staff admin (Fase 1+)
JWT_SECRET="cambia-esto-por-un-secreto-largo-y-aleatorio"

# Puerto (Railway lo inyecta automáticamente)
PORT=3000

# URL pública (para callbacks de pago y enlaces de email)
PUBLIC_BASE_URL="https://grupo3i.com"

# ===== Motor de Viajes — markup (fracción sobre la tarifa neta) =====
TRAVEL_PUBLIC_MARKUP=0.15
TRAVEL_MEMBER_MARKUP=0.05
TRAVEL_MIN_MARKUP_CENTS=250

# ===== HOTELES: RateHawk (ETG/Worldota). Sin estas llaves → mock. =====
RATEHAWK_KEY_ID=""
RATEHAWK_API_KEY=""
RATEHAWK_SANDBOX="true"   # "false" = producción (api.worldota.net)

# ===== VUELOS: Duffel. Sin token → mock. (test = sandbox, live = prod) =====
DUFFEL_TOKEN=""

# ===== PAGOS: PayPhone (Ecuador). Sin token → mock (auto-aprueba). =====
PAYPHONE_TOKEN=""

# ===== EMAIL: Resend. Sin API key → no-op (se loguea). =====
RESEND_API_KEY=""
EMAIL_FROM="Club 3i <reservas@grupo3i.com>"
