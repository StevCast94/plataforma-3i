# Base de datos PostgreSQL de Railway
DATABASE_URL="postgresql://user:password@host:port/dbname"

# Cloudinary (mismo account que OmniDrive/Imeldi)
CLOUDINARY_URL="cloudinary://api_key:api_secret@cloud_name"

# JWT para staff admin (Fase 1+)
JWT_SECRET="cambia-esto-por-un-secreto-largo-y-aleatorio"

# Puerto (Railway lo inyecta automáticamente)
PORT=3000
